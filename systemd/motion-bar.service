[Unit]
Description=Motion Shell system bar
PartOf=graphical-session.target
After=graphical-session.target motion-state.service
Requires=motion-state.service

[Service]
Type=simple
ExecStart=%h/.local/bin/motion-shell --surface=bar
Restart=on-failure
RestartSec=1
Environment=GDK_BACKEND=wayland

[Install]
WantedBy=motion-shell.target
