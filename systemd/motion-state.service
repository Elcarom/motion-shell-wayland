[Unit]
Description=Motion Shell state and integration service
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/lib/motion-shell/motion-service
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/state -%t/motion-shell -%h/Pictures/Screenshots

[Install]
WantedBy=motion-shell.target
